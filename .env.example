# Copy this file to .env and fill in real values. NEVER commit .env to source control.

# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_TAB=Enquiries

# Google Service Account (base64 encoded JSON key file)
# Encode with:  [Convert]::ToBase64String([IO.File]::ReadAllBytes('service-account.json'))
GOOGLE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json_here

# Google Calendar ID (use 'primary' or a specific calendar ID)
GOOGLE_CALENDAR_ID=primary

# Resend API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@zatics.ai

# Webhook secret (random string used to authenticate Apps Script calls)
# Generate with:  openssl rand -hex 32
WEBHOOK_SECRET=your_random_webhook_secret_here
